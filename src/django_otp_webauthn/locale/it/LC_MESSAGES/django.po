#: src/django_otp_webauthn/exceptions.py:19
msgid "Malformed request. JSON not parsable."
msgstr "Richiesta malformata. JSON non analizzabile."

#: src/django_otp_webauthn/exceptions.py:26
msgid ""
"State is missing or invalid. Please begin the operation first before trying "
"to complete it."
msgstr ""
"Lo stato è mancante o non valido. Si prega di avviare il processo prima di "
"tentare di completarlo."

#: src/django_otp_webauthn/exceptions.py:33
msgid "Unprocessable Entity"
msgstr "Entità non elaborabile"

#: src/django_otp_webauthn/exceptions.py:39
msgid "Passwordless login is disabled."
msgstr "L’accesso senza password è disabilitato."

#: src/django_otp_webauthn/exceptions.py:45
msgid "This user account is marked as disabled."
msgstr "Questo account utente è contrassegnato come disabilitato."

#: src/django_otp_webauthn/exceptions.py:51
msgid "This Passkey has been marked as disabled."
msgstr "Questa passkey è stata contrassegnata come disabilitata."

#: src/django_otp_webauthn/exceptions.py:58
msgid "The Passkey you tried to use was not found. Perhaps it was removed?"
msgstr ""
"La passkey che hai provato a usare non è stata trovata. Forse è stata "
"rimossa?"

#: src/django_otp_webauthn/exceptions.py:66
msgid ""
"The Passkey you tried to use does not belong to the currently logged-in "
"user. Try using a different Passkey or logout first to use this Passkey."
msgstr ""
"La passkey che hai provato a usare non appartiene all’utente attualmente "
"connesso. Prova a usare una passkey diversa o esci prima per usare questa "
"passkey."

#: src/django_otp_webauthn/exceptions.py:73
msgid "Authentication required."
msgstr "Autenticazione richiesta."

#: src/django_otp_webauthn/exceptions.py:79
msgid "User is not verified."
msgstr "L’utente non è verificato."

